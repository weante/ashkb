    <string name="ui_exercise_hint_conditional">条件允许时做：仅轻柔体式，幅度以不痛为界。%1$s</string>
    <string name="ui_exercise_hint_pause">当前分期暂停（降级为 L1 轻柔项替代）。</string>
    <string name="ui_exercise_hint_advise_against">不建议：骨折与应力风险随强度上升。</string>
    <string name="ui_exercise_hint_blocked">已拦截：%1$s</string>
