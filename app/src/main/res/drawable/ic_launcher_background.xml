<?xml version="1.0" encoding="utf-8"?>
<!--
  UI 2.0 批次 E「换图」：启动图标底色。
  旧值 #416476（钢青，设计稿 §2.1 明确点名的"现行钢青"）已退役，
  换成品牌梯度 —— 与设计稿 Hero 的 linear-gradient(135deg,#06283A 0%,#084F73 55%,#0B6E9E 100%) 同源，
  收敛到品牌蓝家族（brand-ink → brand-strong → brand），保留「水」的家族感。
  自适应图标的安全区是中央 72dp，底色只负责铺满，前景白色脊柱仍由 ic_launcher_foreground.xml 画。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF06283A" />
                <item android:offset="0.55" android:color="#FF084F73" />
                <item android:offset="1" android:color="#FF0B6E9E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
