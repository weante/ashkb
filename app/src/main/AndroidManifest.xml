<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- v1.0.61 B9：升级链末级「强提醒」用全屏 Intent 唤醒锁屏（Android 14+ 需用户在设置中授予） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- v1.0.62 C11：引导用户把本应用加入电池白名单（否则国产 ROM 可能掐掉后台精确闹钟） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- P4 R20：WebDAV 备份网络访问（R3：强制 HTTPS，明文 http 一律拒绝） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".AshkbApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ashkb">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v1.0.61 B9：强提醒全屏界面——锁屏可见 + 点亮屏幕，独立任务栈不进最近任务 -->
        <activity
            android:name=".ReminderFullScreenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ashkb" />

        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.CheckInActionReceiver"
            android:exported="false" />

        <!-- v1.0.62 C11：测试提醒闹钟触发 -->
        <receiver
            android:name=".reminder.TestReminderReceiver"
            android:exported="false" />

        <!-- v1.0.59 B5：多源提醒——三源各自独立 Receiver，互不影响 -->
        <receiver
            android:name=".reminder.CheckupReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminder.BasdaiReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminder.ExerciseReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- P5 可靠性：系统时间 / 时区变更后 RTC 闹钟失效，必须重排 -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- P5 可靠性：精确闹钟权限回授后从 setWindow 升级回 setExact -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- P4：PDF 报告与备份文件分享 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.ashkb.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
